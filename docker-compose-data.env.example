# Copy to `.env` in the repo root (gitignored) and adjust. Do not commit real credentials.
#
#   cp docker-compose-data.env.example .env
#
# Used by `docker compose -f docker-compose-data.yml`.

# MinIO (object storage for pipeline uploads — dev defaults only)
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio-password

# Jupyter notebook token (dev)
JUPYTER_TOKEN=change-me-jupyter-token

# Pipeline uploads (S3/MinIO)
# Set MLOPS_SKIP_S3_UPLOAD=0 to enable uploads (e.g., to Chameleon MinIO).
MLOPS_SKIP_S3_UPLOAD=0
# For local Compose, MinIO listens on the host as 9000 (see docker-compose-data.yml ports).
MLOPS_S3_ENDPOINT=http://127.0.0.1:9000
MLOPS_S3_ACCESS_KEY=admin
MLOPS_S3_SECRET_KEY=admin12345
MLOPS_S3_BUCKET=moderation-data
MLOPS_S3_REGION=us-east-1

# Optional: override host paths for volumes (defaults under ./.local/mlops/)
# MINIO_DATA_VOLUME=./.local/mlops/minio
# JUPYTER_WORK_VOLUME=./.local/mlops/jupyter
