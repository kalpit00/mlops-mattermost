# Copy to terraform.tfvars. Do not commit terraform.tfvars.
#
# Phase 1 exports (required before terraform plan/apply) — from the lease script; do not duplicate here:
#   export TF_VAR_reservation_id="…"
#   export TF_VAR_keypair_name="…"    # Horizon key pair name (lab: TF_VAR_key)
#   export TF_VAR_prefix="proj17"     # optional; defaults to proj17 in variables.tf if unset
#
# See ../../final-sequence.md Phase 1.

openstack_cloud       = "openstack"
image_name            = "CC-Ubuntu24.04"
flavor_name           = "m1.xxlarge"
existing_instance_id  = ""
network_name          = "sharednet1"
external_network_name = "public"
volume_size_gb        = 50
security_group_cidrs  = ["0.0.0.0/0"]
