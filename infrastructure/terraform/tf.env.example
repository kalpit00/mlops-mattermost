# Copy to `tf.env` (gitignored) if you like to document lease metadata alongside Terraform.
# Terraform reads variables from terraform.tfvars — this file is optional and for humans / shell exports.
#
# === proj17-lease (same values as terraform.tfvars.example) ===
# Lease (Horizon) id:  f9a84d1c-66c3-4d9d-b80b-9376991764ac
# Chameleon project:   89f528973fea4b3a981f9b2344e522de  — must match the project in your OpenStack auth (clouds.yaml)
# Blazar reservation / Nova flavor_id (use as Terraform reservation_id):
#     9e43a450-8a12-4c9e-82ea-a65e44a06782

# Optional: export as TF_VAR_* instead of using terraform.tfvars (same effect as .tfvars keys):
# export TF_VAR_openstack_cloud="openstack"
# export TF_VAR_prefix="proj17"
# export TF_VAR_image_name="CC-Ubuntu24.04"
# export TF_VAR_flavor_name="m1.xxlarge"
# export TF_VAR_reservation_id="9e43a450-8a12-4c9e-82ea-a65e44a06782"
# export TF_VAR_existing_instance_id=""
# export TF_VAR_keypair_name="id_rsa"
# export TF_VAR_network_name="sharednet1"
# export TF_VAR_external_network_name="public"
# export TF_VAR_volume_size_gb=50
# (list vars are awkward from env; prefer terraform.tfvars for security_group_cidrs)
