# Single file for Step D (cluster secrets). Copy to `infrastructure/.env` and fill values.
#
#   cp infrastructure/.env.example infrastructure/.env
#
# `infrastructure/.env` is gitignored — never commit it. Optional: scp to the VM:
#   scp infrastructure/.env cc@<FLOATING_IP>:~/mlops-mattermost/infrastructure/.env
#
# On the VM (from repo root), load and run both scripts:
#   set -a && source infrastructure/.env && set +a
#   ./infrastructure/scripts/create-secrets.sh
#   ./infrastructure/scripts/create-mlops-data-secrets.sh
#
# (Every line below uses `export` so plain `source infrastructure/.env` also works.)
#
# --- Mattermost → Postgres (StatefulSet in `mattermost` namespace) ---
# MM_DB_HOST: same-namespace short name `mattermost-postgres` works, or use the FQDN below.
export MM_DB_USERNAME="mattermost"
export MM_DB_PASSWORD="CHANGE_ME_STRONG"
export MM_DB_HOST="mattermost-postgres.mattermost.svc.cluster.local"
export MM_DB_PORT="5432"
export MM_DB_NAME="mattermost"
#
# --- MinIO (one logical admin; mirrored to every namespace that needs S3) ---
export MINIO_ROOT_USER="CHANGE_ME"
export MINIO_ROOT_PASSWORD="CHANGE_ME_STRONG"
#
# --- Grafana (observability namespace; exposed at grafana.<FIP>.nip.io) ---
export GRAFANA_ADMIN_USER="admin"
export GRAFANA_ADMIN_PASSWORD="CHANGE_ME_STRONG"
#
# --- ArgoCD (argocd namespace; exposed at argocd.<FIP>.nip.io) ---
export ARGOCD_ADMIN_PASSWORD="CHANGE_ME_STRONG"
#
# --- Jupyter in `mlops-data` (required for deploy-all.sh preflight) ---
export DATA_JUPYTER_TOKEN="CHANGE_ME_LONG_RANDOM"
#
# --- Demo ingress hosts (use dash-form nip.io hostnames for the VM floating IP) ---
export MATTERMOST_HOST="129-114-27-105.nip.io"
export MLFLOW_HOST="mlflow.129-114-27-105.nip.io"
export MINIO_HOST="minio.129-114-27-105.nip.io"
export DATA_JUPYTER_HOST="data-jupyter.129-114-27-105.nip.io"
export GRAFANA_HOST="grafana.129-114-27-105.nip.io"
export PROMETHEUS_HOST="prometheus.129-114-27-105.nip.io"
export ALERTMANAGER_HOST="alertmanager.129-114-27-105.nip.io"
export LOKI_HOST="loki.129-114-27-105.nip.io/ready"
export PUSHGATEWAY_HOST="pushgateway.129-114-27-105.nip.io"
export ARGOCD_HOST="argocd.129-114-27-105.nip.io"
