# Copy to: infrastructure/secrets.env
#   cp infrastructure/secrets.env.example infrastructure/secrets.env
# Then fill values and: source infrastructure/secrets.env
#
# infrastructure/secrets.env is gitignored — never commit real credentials.
#
# Used by: scripts/create-secrets.sh (and keep MINIO_* in sync for create-mlops-data-secrets.sh)

# --- Mattermost / Postgres (in-cluster service DNS; match your postgres Service name) ---
export MM_DB_USERNAME="mattermost"
export MM_DB_PASSWORD="CHANGE_ME_STRONG"
export MM_DB_HOST="mattermost-postgres.mattermost.svc.cluster.local"
export MM_DB_PORT="5432"
export MM_DB_NAME="mattermost"

# --- Platform MinIO (single admin user; same logical creds copied to all namespaces that need S3) ---
export MINIO_ROOT_USER="CHANGE_ME"
export MINIO_ROOT_PASSWORD="CHANGE_ME_STRONG"

# Optional: only for create-mlops-data-secrets.sh (namespace mlops-data)
# export DATA_JUPYTER_TOKEN="CHANGE_ME_LONG_RANDOM"
