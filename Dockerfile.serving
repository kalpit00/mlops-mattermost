# Used as mlops-serving:local in k8s/apps/serving/serving.yaml — see infrastructure/docs/DOCKER-BUILDS.md
#   docker build -f Dockerfile.serving -t mlops-serving:local .
FROM python:3.11-slim-bookworm

WORKDIR /app

COPY serving/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY serving/app ./app

ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
